root = true

# Everything in this repo is text. Keep LF + UTF-8 so the synced docs diff cleanly
# against their source repos and the future Confluence/RAG tooling reads them as-is.
[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a Markdown hard break; never strip them.
trim_trailing_whitespace = false

[*.py]
indent_style = space
indent_size = 4
