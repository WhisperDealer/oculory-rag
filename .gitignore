# Editor / OS
.vscode/
.venv/
.DS_Store
Thumbs.db
__pycache__/
*.pyc

# Per-machine Claude Code overrides
/.claude/settings.local.json

# Derived tooling state — the indexes are rebuildable, never committed.
/rag/index/
/rag/*.db

# GAME DATA — copyrighted Bethesda / SureAI content. NEVER COMMIT ANY OF IT.
# The decompiled plugin dumps and Papyrus source are indexed *in place* from the source
# repos (see rag/gamesources.json); nothing is copied here. Both source repos gitignore
# their own reference/ trees. These patterns are a backstop in case anything is ever
# copied or extracted into this repo by mistake.
/docs/game/
/game/
/reference/
**/reference/Base/
**/reference/base/
*.psc
*.pex
*.esp
*.esm
*.esl
*.bsa
*.ba2

# NOTE: docs/ is generated by tools/sync.py but IS committed on purpose, so the history
# shows how the knowledge base drifted. Never hand-edit it; re-run the sync.
